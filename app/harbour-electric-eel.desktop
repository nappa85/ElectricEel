[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-electric-eel
Exec=harbour-electric-eel
Name=ElectricEel
Name[en]=ElectricEel
Comment=Control your Tesla over Bluetooth
Comment[en]=Control your Tesla over Bluetooth
# Share target for navigation destinations (docs/navigation-share.md).
# Must live in [Desktop Entry]: sailfish-share-update-cache only reads
# this group (a copy under [X-Sailjail] is silently ignored, leaving
# /var/lib/sailfish-share/desktopfiles.list empty). Do NOT add a Share
# permission — Harbour QA rejects it.
X-Share-Methods=destination

[X-Sailjail]
Permissions=Bluetooth;Documents
OrganizationName=org.electriceel
ApplicationName=harbour-electric-eel

[X-Share Method destination]
Description=Send to car navigation
Capabilities=text/plain;text/x-url;
SupportsMultipleFiles=no
