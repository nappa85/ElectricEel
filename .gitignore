# Prebuilt/cross-compiled binaries - see README.md for how to rebuild them.
# Not committed: they can't be verified from source by reading the repo,
# so build fresh from a pinned upstream commit instead of trusting a blob
# in git (see KNOWN_ISSUES.md).
spike/bin/
helper/dist/

# Phase 4 in-app core artifact (helper/make-app-bundle.sh stages these into
# the app's qmake tree so the app RPM bundles the Rust core + Go child)
app/thirdparty/
app/bin/

# Build logs (environment-specific, no reuse value)
spike/*.log

# rpmbuild staging trees and built packages - fully regenerated by the
# build steps documented in README.md
helper/rpmbuild/
app/RPMS/
helper/RPMS/
*.rpm
*.tar.bz2
*.tar.gz

# Qt/qmake build output
app/build/
app/*.pro.user
app/*.pro.user.*
Makefile
Makefile.*
.qmake.stash
*.o
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*_qmlcache.qrc

# Rust build output (electric-eel-daemon)
/helper/target/
/helper/electric-eel-daemon

# Go build output (tesla-session) - `go build .` with no -o names the
# binary after the module (electric-eel-session)
/helper/session/electric-eel-session
/helper/session/tesla-session

# Local build counter: "<version> <release>"
.build-release

# Editor / OS cruft
.vscode/
.idea/
*.swp
*.swo
.DS_Store
